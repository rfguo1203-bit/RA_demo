# DeepSeek-V4-Flash-0731 text-model deployment configuration.

MODEL_PATH=/srv/data2/g00806422/model_weights/DeepSeek-V4-Flash-0731
SERVED_MODEL_NAME=deepseek-v4-flash-0731

# Point this at the vLLM executable in the DeepSeek-specific environment.
# Replace this placeholder after creating that environment on the server.
VLLM_BIN=/root/g00806422/embodiment/RA_demo/vlm-server/.venv_ds/bin/vllm

VLLM_HOST=0.0.0.0
VLLM_PORT=8128

# Baseline configuration for 8 x H100.
TENSOR_PARALLEL_SIZE=8
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
MAX_MODEL_LEN=393216

GPU_MEMORY_UTILIZATION=0.90
VLLM_LOG_LEVEL=INFO
KV_CACHE_DTYPE=fp8
BLOCK_SIZE=256
ENABLE_EXPERT_PARALLEL=1

# DeepSeek-V4 uses its dedicated OpenAI-message encoder and output parsers.
TOKENIZER_MODE=deepseek_v4
REASONING_PARSER=deepseek_v4
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=deepseek_v4

# Enable thinking with high reasoning effort by default. Use "max" only with
# a model context length of at least 393216 tokens.
DEFAULT_CHAT_TEMPLATE_KWARGS='{"thinking":true,"reasoning_effort":"high"}'

# Client/probe settings.
VLLM_BASE_URL=http://127.0.0.1:8128/v1
VLLM_API_KEY=EMPTY
