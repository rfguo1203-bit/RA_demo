# Qwen3.5-397B-A17B-FP8 local deployment configuration.

MODEL_PATH=/srv/data2/g00806422/model_weights
SERVED_MODEL_NAME=qwen3.5-397b-a17b-fp8

VLLM_HOST=0.0.0.0
VLLM_PORT=8000

# 8 x H100 deployment.
TENSOR_PARALLEL_SIZE=8
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# The model card lists 262144 as the native context length.
MAX_MODEL_LEN=262144

# Optional vLLM tuning.
GPU_MEMORY_UTILIZATION=0.90
VLLM_LOG_LEVEL=INFO
REASONING_PARSER=qwen3

# Use the model's tool-use chat template when serving it as an agent model.
# Leave empty for ordinary chat/VLM serving if your vLLM build does not support
# the named template.
CHAT_TEMPLATE=tool_use

# Qwen3.5 defaults to thinking mode. OpenAI-compatible clients such as
# OpenCode may not send chat_template_kwargs per request, so disable thinking
# server-wide by default to make answers appear in message.content.
DEFAULT_CHAT_TEMPLATE_KWARGS={"enable_thinking": false}

# Enable this only when the client sends tools with tool_choice="auto".
# Qwen3 uses Hermes-style tool calling in vLLM.
ENABLE_AUTO_TOOL_CHOICE=0
TOOL_CALL_PARSER=hermes

# Client/probe settings.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
