# Qwen3.5-397B-A17B-FP8 local deployment configuration.

MODEL_PATH=/srv/data2/g00806422/model_weights
SERVED_MODEL_NAME=qwen3.5-397b-a17b-fp8

VLLM_HOST=0.0.0.0
VLLM_PORT=8000

# 8 x H100 deployment.
TENSOR_PARALLEL_SIZE=8
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# The model card lists 262144 as the native context length.
MAX_MODEL_LEN=262144

# Optional vLLM tuning.
GPU_MEMORY_UTILIZATION=0.90
VLLM_LOG_LEVEL=INFO

# Client/probe settings.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY

